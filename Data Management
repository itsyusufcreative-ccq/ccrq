                callBtn: "Appeler",
                resetPointsBtn: "Réinitialiser Points"
            }
        };

        // Load language from localStorage
        const savedLanguage = localStorage.getItem('language') || 'en';
        setLanguage(savedLanguage);

        // Load theme from localStorage
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            document.body.classList.add('dark');
        }

        // Load data from localStorage on startup
        try {
            clients = JSON.parse(localStorage.getItem('clients')) || [];
        } catch (e) {
            alert('Failed to load data. Starting fresh.');
        }

        // Auto Backup Daily
        function autoBackup() {
            const today = new Date().toDateString();
            const lastBackup = localStorage.getItem('lastBackup');
            if (lastBackup !== today) {
                localStorage.setItem('clientsBackup', JSON.stringify(clients));
                localStorage.setItem('lastBackup', today);
                console.log('Daily backup completed.');
            }
        }
        setInterval(autoBackup, 24 * 60 * 60 * 1000); // Check every 24 hours

        // Save data to localStorage on unload
        window.addEventListener('beforeunload', () => {
            localStorage.setItem('clients', JSON.stringify(clients));
        });

        // Save data to localStorage and refresh UI
        function saveClients() {
            try {
                localStorage.setItem('clients', JSON.stringify(clients));
            } catch (e) {
                alert('Failed to save data. Check browser storage settings.');
            }
            renderClients();
            renderReport();
            renderNotifications();
        }

        // Toggle Dark Mode
        function toggleTheme() {
            document.body.classList.toggle('dark');
            const theme = document.body.classList.contains('dark') ? 'dark' : 'light';
            localStorage.setItem('theme', theme);
        }

        // Set Language
        function setLanguage(lang) {
            currentLanguage = lang;
            localStorage.setItem('language', lang);
            document.getElementById('languageSelect').value = lang;
            document.body.classList.toggle('rtl', lang === 'ar');
            const t = translations[lang];
            document.getElementById('appTitle').textContent = t.appTitle;
            document.getElementById('notificationsTitle').textContent = t.notificationsTitle;
            document.getElementById('nameHeader').textContent = t
